<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Excludes the favorites/session-cache DB and the session DataStore (uid/email) from
             cloud backup, per the secure-storage-audit finding and constitution Principle II. -->
        <exclude domain="database" path="devfestmilano26.db" />
        <exclude domain="file" path="datastore/session.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="devfestmilano26.db" />
        <exclude domain="file" path="datastore/session.preferences_pb" />
    </device-transfer>
</data-extraction-rules>